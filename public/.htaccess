<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Proxy /api/* requests to the Node.js backend ──────────────────────────
  RewriteCond %{REQUEST_URI} ^/api/ [NC]
  RewriteRule ^api/(.*)$ http://localhost:8080/api/$1 [P,L]

  # ── Proxy /uploads/* (local uploaded files) to the Node.js backend ─────────
  RewriteCond %{REQUEST_URI} ^/uploads/ [NC]
  RewriteRule ^uploads/(.*)$ http://localhost:8080/uploads/$1 [P,L]

  # ── Serve React SPA for all other routes ──────────────────────────────────
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_proxy.c>
  ProxyPassReverse /api/ http://localhost:8080/api/
  ProxyPassReverse /uploads/ http://localhost:8080/uploads/
</IfModule>

# ── Hostinger Compression (mod_deflate) ───────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml image/svg+xml
</IfModule>

# ── Hostinger Browser Caching & Expiry (mod_expires / mod_headers) ────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML must not be cached to ensure instant delivery of new builds
  ExpiresByType text/html "access plus 0 seconds"

  # Fingerprinted Vite assets (JS, CSS) cached for 1 year
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Media & Images
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Fingerprinted Vite assets in /assets/ are immutable
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML entry point must revalidate
  <FilesMatch "(index\.html|index\.htm)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Security Header
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
